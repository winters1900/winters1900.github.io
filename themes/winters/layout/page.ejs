<div class="article-shell">
  <article>
    <header class="article-header compact">
      <h1><%= page.title %></h1>
      <% if (page.description) { %>
        <p class="article-description"><%= page.description %></p>
      <% } %>
    </header>
    <div class="article-content">
      <%- page.content %>
    </div>
  </article>
</div>
