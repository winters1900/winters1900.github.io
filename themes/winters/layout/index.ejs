<section class="hero">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><%= theme.hero.eyebrow %></p>
      <h1><%= theme.hero.title %></h1>
      <p class="hero-description"><%= theme.hero.description %></p>
      <a class="primary-link" href="<%- url_for('/categories/agent-notes/') %>">阅读第一篇笔记</a>
    </div>
    <figure class="hero-visual">
      <img src="<%- url_for(theme.hero.image) %>" width="1536" height="1024" alt="Agent 工作流与部署路径的抽象图" fetchpriority="high" decoding="async">
    </figure>
  </div>
</section>

<section class="section shell" aria-labelledby="latest-heading">
  <div class="section-heading">
    <h2 id="latest-heading">最新笔记</h2>
    <a class="text-link" href="<%- url_for('/archives/') %>">查看归档</a>
  </div>
  <%- partial('_partial/post-list', { posts: page.posts }) %>
</section>

<section class="section shell" aria-labelledby="category-heading">
  <div class="section-heading stacked">
    <h2 id="category-heading">按主题浏览</h2>
    <p>两个分类先从最需要沉淀的方向开始。</p>
  </div>
  <div class="category-grid">
    <% (theme.categories || []).forEach(function(item) { %>
      <% const category = site.categories.findOne({ name: item.name }); %>
      <% const count = category ? category.length : 0; %>
      <% const href = category ? url_for(category.path) : url_for(`/categories/#${item.slug}`); %>
      <a class="category-panel" href="<%- href %>">
        <span class="category-count"><%= count %> 篇</span>
        <h3><%= item.name %></h3>
        <p><%= item.description %></p>
      </a>
    <% }); %>
  </div>
</section>
