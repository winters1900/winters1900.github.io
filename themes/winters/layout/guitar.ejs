<%
  const guitarData = (site.data && site.data.guitar_sheets) || { sheets: [] };
  const sheets = guitarData.sheets || [];
  const typeMeta = {
    fingerstyle: { label: '指弹独奏', cls: 't-finger' },
    chord:       { label: '和弦弹唱', cls: 't-chord' },
    score:       { label: '五线谱·六线谱', cls: 't-score' }
  };
  const repoUrl = (theme.guitar && theme.guitar.repo_url) || 'https://github.com/winters1900/guitar_sheet';
  const spec = (s) => [s.tuning, s.capo, s.tempo].filter(Boolean);
  const searchText = (s) => [s.title, s.work, s.tabber, s.tuning, s.capo, s.tempo]
    .concat(s.tags || []).join(' ').toLowerCase();
%>
<section class="guitar-page">
  <header class="guitar-hero">
    <span class="hero-eyebrow">Guitar Sheets</span>
    <h1>吉他谱</h1>
    <p class="guitar-hero-sub">收录改编与原创的指弹、和弦与六线谱，全部为 PDF，可直接在线打开或下载练习。</p>
    <div class="guitar-hero-actions">
      <a class="btn btn-primary" href="<%- url_for('/guitar/upload/') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        上传吉他谱
      </a>
      <a class="btn btn-ghost" href="<%- repoUrl %>" target="_blank" rel="noopener noreferrer">谱库仓库</a>
    </div>
    <div class="guitar-hero-meta">
      <span class="guitar-count"><strong id="guitar-count-num"><%= sheets.length %></strong> 份谱</span>
      <span class="guitar-dot" aria-hidden="true">·</span>
      <span>来源：<a href="<%- repoUrl %>" target="_blank" rel="noopener noreferrer">guitar_sheet</a></span>
    </div>
  </header>

  <div class="guitar-toolbar">
    <div class="guitar-filters" role="group" aria-label="按谱类型筛选">
      <button type="button" class="chip is-active" data-filter="all">全部</button>
      <button type="button" class="chip" data-filter="fingerstyle">指弹独奏</button>
      <button type="button" class="chip" data-filter="chord">和弦弹唱</button>
      <button type="button" class="chip" data-filter="score">五线谱·六线谱</button>
    </div>
    <label class="guitar-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="search" id="guitar-search-input" placeholder="搜索曲目 / 出处 / 标签…" aria-label="搜索吉他谱" autocomplete="off">
    </label>
  </div>

  <% if (sheets.length === 0) { %>
    <p class="guitar-empty">吉他谱清单正在同步中，稍后再来看看，或前往 <a href="<%- repoUrl %>" target="_blank" rel="noopener noreferrer">谱库仓库</a>。</p>
  <% } else { %>
    <div class="guitar-grid" id="guitar-grid">
      <% sheets.forEach(function(s) {
           const tm = typeMeta[s.type] || typeMeta.fingerstyle;
           const specs = spec(s);
      %>
        <article class="sheet-card" data-type="<%= s.type %>" data-search="<%= searchText(s) %>">
          <a class="sheet-thumb" href="<%- url_for(s.url) %>" target="_blank" rel="noopener noreferrer"
             data-pdf="<%- url_for(s.url) %>" aria-label="打开《<%= s.title %>》吉他谱 PDF">
            <span class="sheet-badge <%= tm.cls %>"><%= tm.label %></span>
            <span class="sheet-thumb-frame">
              <span class="sheet-thumb-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                <span>PDF</span>
              </span>
              <canvas class="sheet-thumb-canvas" aria-hidden="true"></canvas>
              <span class="sheet-thumb-zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </span>
            </span>
          </a>

          <div class="sheet-body">
            <h2 class="sheet-title"><a href="<%- url_for(s.url) %>" target="_blank" rel="noopener noreferrer"><%= s.title %></a></h2>
            <p class="sheet-source">
              <% if (s.work) { %><span class="sheet-work"><%= s.work %></span><% } %>
              <% if (s.tabber) { %><span class="sheet-tabber">制谱 · <%= s.tabber %></span><% } %>
            </p>

            <% if (specs.length) { %>
              <ul class="sheet-specs">
                <% specs.forEach(function(item) { %><li><%= item %></li><% }); %>
              </ul>
            <% } %>

            <% if (s.tags && s.tags.length) { %>
              <div class="sheet-tags">
                <% s.tags.forEach(function(t) { %><span class="sheet-tag">#<%= t %></span><% }); %>
              </div>
            <% } %>

            <% if (s.note) { %><p class="sheet-note"><%= s.note %></p><% } %>

            <div class="sheet-foot">
              <span class="sheet-pages">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                <%= s.pages %> 页
              </span>
              <a class="sheet-download" href="<%- url_for(s.url) %>" download="<%= s.file %>" title="下载 <%= s.file %>">
                下载
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </a>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
    <p class="guitar-empty" id="guitar-empty" hidden>没有找到符合条件的吉他谱。</p>
  <% } %>
</section>

<script src="<%- url_for('/js/vendor/pdf.min.js') %>" defer></script>
<script src="<%- url_for('/js/guitar-gallery.js') %>" defer></script>
