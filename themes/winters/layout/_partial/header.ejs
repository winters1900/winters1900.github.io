<%
  const navItems = [
    { label: '首页', url: '/' },
    ...(theme.sections || []),
    { label: '文章', url: '/archives/' },
    { label: '关于', url: '/about/' }
  ];
  const currentPath = '/' + (page.path || '').replace(/index\.html$/, '');
  const isActive = function(item) {
    const u = item.url || '/';
    if (u === '/') return currentPath === '/';
    return currentPath.indexOf(u) === 0;
  };
%>
<nav class="nav" id="site-nav-bar">
  <div class="nav-inner">
    <a href="<%- url_for('/') %>" class="nav-logo" id="navLogo" aria-label="返回首页">
      <span class="ch ch-w">Winters</span><span class="ch ch-space">&nbsp;</span><span class="ch ch-blog">Blog</span>
    </a>

    <div class="nav-right">
      <div class="nav-links" id="site-nav-links" data-menu>
        <% navItems.forEach(function(item) { %>
          <a href="<%- url_for(item.url) %>"<% if (isActive(item)) { %> class="active" aria-current="page"<% } %>><%= item.label || item.name %></a>
        <% }); %>
      </div>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深色模式" title="切换深色模式" aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>

      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav-links">
        菜单
      </button>
    </div>
  </div>
</nav>
