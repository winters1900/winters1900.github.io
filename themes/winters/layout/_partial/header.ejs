<header class="site-header">
  <div class="shell header-inner">
    <a class="site-brand" href="<%- url_for('/') %>" aria-label="返回首页">
      <span class="brand-name"><%= config.title %></span>
      <span class="brand-subtitle"><%= config.subtitle %></span>
    </a>

    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">
      菜单
    </button>

    <nav class="site-nav" id="site-nav" data-menu aria-label="主导航">
      <a href="<%- url_for('/') %>">首页</a>
      <% (theme.categories || []).forEach(function(item) { %>
        <% const category = site.categories.findOne({ name: item.name }); %>
        <% const href = category ? url_for(category.path) : url_for(`/categories/#${item.slug}`); %>
        <a href="<%- href %>"><%= item.name %></a>
      <% }); %>
      <a href="<%- url_for('/archives/') %>">归档</a>
      <a href="<%- url_for('/about/') %>">关于</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换到深色主题">
        主题
      </button>
    </nav>
  </div>
</header>
