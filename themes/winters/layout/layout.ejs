<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
  <head>
    <% const contentTitle = page.title || page.category || page.tag; %>
    <% const pageTitle = contentTitle ? `${contentTitle} | ${config.title}` : config.title; %>
    <% const categoryConfig = page.category && (theme.categories || []).find(function(item) { return item.name === page.category; }); %>
    <% const rawDescription = page.description || (categoryConfig && categoryConfig.description) || page.excerpt || config.description; %>
    <% const pageDescription = truncate(strip_html(rawDescription || ''), { length: 150 }); %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#F9F7F4" id="meta-theme-color">
    <script>
      /* 防闪烁：在 CSS 加载前尽早确定主题（localStorage 手动选择优先，否则跟随系统） */
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored === 'dark' ||
            ((!stored || stored === 'auto') &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) {
            document.documentElement.setAttribute('data-theme', 'dark');
            var meta = document.getElementById('meta-theme-color');
            if (meta) meta.setAttribute('content', '#262220');
          }
        } catch (e) {}
      })();
    </script>
    <meta name="description" content="<%= pageDescription %>">
    <meta name="author" content="<%= config.author %>">
    <meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:url" content="<%= full_url_for(page.path || '') %>">
    <meta property="og:site_name" content="<%= config.title %>">
    <meta property="og:locale" content="zh_CN">
    <% if (theme.hero && theme.hero.image) { %>
      <meta property="og:image" content="<%= full_url_for(theme.hero.image) %>">
    <% } %>
    <meta name="twitter:card" content="summary_large_image">
    <link rel="canonical" href="<%= full_url_for(page.path || '') %>">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23D97757'/><text x='50' y='70' font-size='56' font-family='serif' fill='white' text-anchor='middle'>W</text></svg>">
    <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%= full_url_for('/atom.xml') %>">
    <link rel="preconnect" href="https://miaoda.feishu.cn" crossorigin>
    <link rel="stylesheet" href="https://miaoda.feishu.cn/fonts/css2?family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500;6..72,600;6..72,700&family=DM+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
    <script src="<%- url_for('/js/theme.js') %>" defer></script>
    <title><%= pageTitle %></title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <%- partial('_partial/header') %>
    <main id="main-content">
      <%- body %>
    </main>
    <%- partial('_partial/footer') %>
  </body>
</html>
